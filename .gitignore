# Local-only source archive. Keep the safe instructions and example schema.
/private/*
!/private/README.md
!/private/source-map.example.yml

# Legacy local aliases for private source material.
/*.m4a
/*.wav
/*.csv
/*.pdf
/*.txt
/derived/.transcription-work
/derived/2026-08-21_*.md
/derived/2026-08-24_전체자료_검토_후_실행_결정안.md
/derived/GAME_THREAD_INDEX.md

# Generated files and dependencies.
**/node_modules
**/dist/
**/.next/
**/.vinext/
**/.wrangler/
**/.playwright-cli/
**/output/
**/.vite/
**/*.tsbuildinfo
**/*.log
**/.DS_Store
/outputs/
/tmp/

# Legacy per-game reports with private or inactive names stay local. Keep only
# the public compatibility index in this directory.
/derived/implementation-reports/*
!/derived/implementation-reports/README.md

# Local compatibility aliases for paths used before the monorepo migration.
# Fresh clones use docs/project/REPOSITORY_MAP.md instead.
/prototype
/site-release
/sister-wakeup
/sister-wakeup-site
/forever-young
/breakup-notice
/night-flight
/copy-editor-apps-script
/spreadsheet-build

# Local deployment and environment state.
**/.openai/hosting.json
**/.env
**/.env.*
**/*.local
**/*.pem
**/*.key
**/*.p12
**/*.mobileprovision
